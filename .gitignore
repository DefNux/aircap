# downloaded archives and caches — a mid-download tarball once got committed here
.cache/
*.tar.gz
*.tar.zst
*.tgz
*.zip

# attack-planted corpus documents are generated artifacts, not source. Allowlist the
# three baseline documents explicitly - a bare wildcard here once let seven planted
# documents into a commit.
lab/app/corpus/*.md
!lab/app/corpus/onboarding.md
!lab/app/corpus/expenses.md
!lab/app/corpus/support-sla.md

# generated telemetry & evidence — never commit real captures
data/
incidents/INC-*
mappings/.cache/
*.duckdb
*.duckdb.wal

# secrets
*.key
*.pem
*.backup
.env
.env.*
!.env.example
credentials
*_key
sk-*

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
.terraform.lock.hcl

# os / editor
.DS_Store
*.swp
