# AIRCAP lab configuration. Copy to .env and edit. Never commit .env.
AIRCAP_OLLAMA_URL=http://127.0.0.1:11434
AIRCAP_MODEL_ID=llama3.2:3b-instruct-q4_K_M
AIRCAP_DATA_DIR=./data
AIRCAP_ACCOUNT_ID=123456789012
AIRCAP_REGION=us-east-1
AIRCAP_ROLE_NAME=aircap-app-role

# --- vulnerability toggles: all false = hardened baseline ---
AIRCAP_TRUST_RETRIEVED_CONTENT=false
AIRCAP_NO_TOOL_ALLOWLIST=false
AIRCAP_ALLOW_UNSCOPED_FETCH=false
AIRCAP_NO_OUTPUT_FILTER=false
AIRCAP_MAX_TOOL_DEPTH=3
AIRCAP_MAX_PROMPT_CHARS=8000
AIRCAP_GUARDRAIL_ID=aircap-baseline-gr
